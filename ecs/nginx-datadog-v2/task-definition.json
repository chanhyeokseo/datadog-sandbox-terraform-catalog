{
  "containerDefinitions": [
    {
      "name": "nginx",
      "image": "nginx:latest",
      "cpu": 128,
      "memory": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "command": [
        "sh", "-c",
        "echo 'server { listen 80; location / { root /usr/share/nginx/html; index index.html; } location /nginx_status { stub_status on; allow all; } }' > /etc/nginx/conf.d/default.conf && nginx -g \"daemon off;\""
      ],
      "dockerLabels": {
        "com.datadoghq.tags.env": "dev",
        "com.datadoghq.tags.service": "nginx",
        "com.datadoghq.tags.version": "latest",
        "com.datadoghq.ad.checks": "{\"nginx\":{\"init_config\":{},\"instances\":[{\"nginx_status_url\":\"http://%%host%%:%%port%%/nginx_status\"}]}}",
        "com.datadoghq.ad.logs": "[{\"source\":\"nginx\",\"service\":\"nginx\"}]"
      }
    }
  ],
  "volumes": [],
  "family": "nginx-datadog-v2"
}
