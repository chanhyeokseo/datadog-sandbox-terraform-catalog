{
  "containerDefinitions": [
    {
      "name": "nginx",
      "image": "nginx:latest",
      "cpu": 128,
      "memory": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "command": [
        "sh", "-c",
        "echo 'server { listen 80; location / { root /usr/share/nginx/html; index index.html; } location /nginx_status { stub_status on; allow all; } }' > /etc/nginx/conf.d/default.conf && nginx -g \"daemon off;\""
      ],
      "dockerLabels": {
        "com.datadoghq.ad.check_names": "[\"nginx\"]",
        "com.datadoghq.ad.init_configs": "[{}]",
        "com.datadoghq.ad.instances": "[{\"nginx_status_url\": \"http://%%host%%:%%port%%/nginx_status\"}]"
      }
    }
  ],
  "volumes": [],
  "family": "nginx-datadog-v1"
}
