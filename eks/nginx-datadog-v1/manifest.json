{
  "name": "nginx-datadog-v1",
  "description": "Nginx with Datadog autodiscovery v1 annotations",
  "type": "kubectl",
  "built_in": true,
  "deploy_commands": [
    "kubectl apply -f deployment.yaml"
  ],
  "update_commands": [
    "kubectl apply -f deployment.yaml"
  ],
  "undeploy_commands": [
    "kubectl delete -f deployment.yaml --ignore-not-found"
  ],
  "files": ["deployment.yaml"]
}
