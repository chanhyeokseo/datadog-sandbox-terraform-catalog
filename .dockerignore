# Exclude everything by default
*

# Include only what we need
!instances/
!modules/
!apps/
!eks/
!ecs/
!webui/
!mcp-server/

# Exclude unnecessary files from webui
webui/node_modules
webui/.git
webui/*/node_modules
webui/backend/__pycache__
webui/backend/**/*.pyc
webui/backend/.pytest_cache
webui/frontend/dist
webui/frontend/build
webui/frontend/node_modules

# Exclude dev/test artifacts from mcp-server
mcp-server/.venv
mcp-server/__pycache__
mcp-server/.pytest_cache
mcp-server/tests

# Exclude test files from webui backend
webui/backend/tests

# Exclude legacy and other large directories
legacy/
.git/
*.tfstate
*.tfstate.backup
.terraform/
